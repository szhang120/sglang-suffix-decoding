diff --git a/python/sglang/srt/speculative/suffix_worker.py b/python/sglang/srt/speculative/suffix_worker.py
new file mode 100644
index 0000000..145902d
--- /dev/null
+++ b/python/sglang/srt/speculative/suffix_worker.py
@@ -0,0 +1,259 @@
+"""Linear batch-one SuffixDecoding, using SGLang's NGRAM target verifier."""
+
+import json
+import os
+
+import numpy as np
+from sglang.srt.runtime_context import get_exec, get_spec
+from sglang.srt.speculative.ngram_worker import NGRAMWorker
+from suffix_native.cache import SuffixDecodingCache
+
+
+class SuffixWorker(NGRAMWorker):
+    def __init__(self, *args, **kwargs):
+        super().__init__(*args, **kwargs)
+        from sglang.srt.model_executor.cuda_graph_config import Backend
+
+        graphs = get_exec().graph.cuda_graph_config
+        if (
+            graphs.decode.backend != Backend.DISABLED
+            or graphs.prefill.backend != Backend.DISABLED
+        ):
+            raise ValueError("SUFFIX requires disabled prefill and decode CUDA graphs")
+        self.max_width = self.draft_token_num
+        self.suffix_cache = SuffixDecodingCache(
+            max_tree_depth=64,
+            max_cached_requests=int(os.environ.get("SUFFIX_CACHE_REQUESTS", "128")),
+        )
+        self.factor = float(os.environ.get("SUFFIX_FACTOR", "1.0"))
+        self.offset = float(os.environ.get("SUFFIX_OFFSET", "0.0"))
+        self.min_prob = float(os.environ.get("SUFFIX_MIN_PROB", "0.1"))
+        self.fixed = os.environ.get("SUFFIX_FIXED", "0") == "1"
+        self.requests = {}
+        self.seen = {}
+        self.prepared = None
+        self.trace = os.environ.get("SUFFIX_TRACE")
+        self.trace_logits = os.environ.get("SUFFIX_TRACE_LOGITS") == "1"
+        self.allow_width_probe = os.environ.get("SUFFIX_ALLOW_WIDTH_PROBE") == "1"
+
+    def clear_cache_pool(self):
+        self.suffix_cache = SuffixDecodingCache(
+            64, self.suffix_cache.max_cached_requests
+        )
+        self.requests.clear()
+        self.seen.clear()
+        self._prev_decode_rids = set()
+
+    def _sync_request(self, req):
+        rid = req.rid
+        if rid not in self.requests:
+            self.suffix_cache.start_request(rid, list(req.origin_input_ids))
+            self.requests[rid] = req
+            self.seen[rid] = 0
+        output = req.output_ids_through_stop
+        n = self.seen[rid]
+        if len(output) < n:
+            raise RuntimeError("Suffix cache cannot roll back committed output")
+        self.suffix_cache.add_active_response(rid, list(output[n:]))
+        self.seen[rid] = len(output)
+
+    def discard_request(self, rid):
+        if rid in self.requests:
+            self.suffix_cache.stop_request(rid)
+            if rid in self.suffix_cache.cached_requests:
+                self.suffix_cache.evict_cached_response(rid)
+            del self.requests[rid]
+            del self.seen[rid]
+
+    def note_request_finished(self, *, rid, natural_stop):
+        req = self.requests.get(rid)
+        if req is not None:
+            self._sync_request(req)
+            self.suffix_cache.stop_request(rid)
+            if not natural_stop:
+                # Length-limited outputs are useful too; aborts must not persist.
+                from sglang.srt.managers.schedule_batch import FINISH_ABORT
+
+                if isinstance(req.finished_reason, FINISH_ABORT):
+                    if rid in self.suffix_cache.cached_requests:
+                        self.suffix_cache.evict_cached_response(rid)
+            del self.requests[rid]
+            del self.seen[rid]
+
+    def _select_width(self, width):
+        # Reuse capacity-sized storage, with true width-sized views. No padded
+        # rows reach the target forward. Scheduler KV reservation stays maximal.
+        self.draft_token_num = self.speculative_num_draft_tokens = width
+        self.draft_tokens_batch[1] = self.draft_tokens[:width]
+        self.positions_batch[1] = self.positions[:width]
+        self.tree_mask_batch[1] = self.tree_mask[: width * width]
+        self.retrieve_indexes_batch[1] = self.retrieve_indexes[:1, :width]
+        self.retrieve_next_token_batch[1] = self.retrieve_next_token[:1, :width]
+        self.retrieve_next_sibling_batch[1] = self.retrieve_next_sibling[:1, :width]
+
+    def _prepare_draft_tokens(self, batch):
+        return self.prepared
+
+    def _update_ngram_corpus(self, batch):
+        # Only scheduler-committed output may enter either suffix tree. The
+        # next proposal (or completion hook) synchronizes req.output_ids.
+        pass
+
+    def forward_batch_generation(self, batch, on_publish=None, pp_proxy_tensors=None):
+        if len(batch.reqs) > 1:
+            raise ValueError("SUFFIX supports batch one only")
+        if batch.has_grammar or batch.return_logprob:
+            raise ValueError("SUFFIX initial scope excludes grammar/logprobs")
+        if not batch.sampling_info.is_all_greedy:
+            raise ValueError("SUFFIX requires greedy sampling")
+        for req in batch.reqs:
+            params = req.sampling_params
+            for name, default in (
+                ("frequency_penalty", 0.0),
+                ("presence_penalty", 0.0),
+                ("repetition_penalty", 1.0),
+                ("min_new_tokens", 0),
+            ):
+                if getattr(params, name, default) != default:
+                    raise ValueError(f"SUFFIX requires default {name}")
+            custom = getattr(params, "custom_params", None) or {}
+            probe_width = custom.get("suffix_probe_width")
+            if probe_width is not None:
+                if not self.allow_width_probe:
+                    raise ValueError("suffix_probe_width requires SUFFIX_ALLOW_WIDTH_PROBE=1")
+                if type(probe_width) is not int or not 1 <= probe_width <= self.max_width:
+                    raise ValueError("suffix_probe_width must be an integer within capacity")
+            self._sync_request(req)
+        decoding = batch.forward_mode.is_decode()
+        output_len_before = len(batch.reqs[0].output_ids) if decoding else 0
+        width = self.max_width
+        match_len = 0
+        if batch.forward_mode.is_decode():
+            if not batch.sampling_info.is_all_greedy:
+                raise ValueError("SUFFIX requires greedy sampling")
+            req = batch.reqs[0]
+            context = self._efficient_concat_last_n(
+                list(req.origin_input_ids[-64:]), list(req.output_ids[-64:]), 64
+            )
+            if not req.output_ids:
+                raise RuntimeError("Decode requires a committed root token")
+            remaining = req.sampling_params.max_new_tokens - len(req.output_ids)
+            cap = max(0, min(self.max_width - 1, remaining - 1))
+            draft = self.suffix_cache.speculate(
+                req.rid,
+                context,
+                max_spec_tokens=cap,
+                max_spec_factor=1e6 if self.fixed else self.factor,
+                max_spec_offset=self.offset,
+                min_token_prob=self.min_prob,
+                use_tree_spec=False,
+            )
+            tokens = [context[-1]] + draft.token_ids
+            if probe_width is not None:
+                # Profiling/warmup only. Arbitrary candidates are still verified;
+                # they cannot become cache contents or outputs before acceptance.
+                tokens = [context[-1]] + [0] * min(probe_width - 1, cap)
+            width = len(tokens)
+            match_len = draft.match_len
+            self.prepared = (
+                np.asarray(tokens, dtype=np.int64),
+                np.tril(np.ones((width, width), dtype=np.bool_)).flatten(),
+            )
+        self._select_width(width)
+        # Backend metadata and sampler must see the same active width. CUDA
+        # graphs are disabled by validation, so no capture can pad this shape.
+        from contextlib import nullcontext
+
+        annotation = nullcontext()
+        if self.trace and decoding:
+            from torch.profiler import record_function
+
+            annotation = record_function(
+                f"suffix_verify[rows={width} out={output_len_before} rid={batch.reqs[0].rid}]"
+            )
+        prefix_snapshot = None
+        if self.trace and self.trace_logits and decoding:
+            # Full prefix preservation check for dense Qwen, outside timings.
+            pool = self.token_to_kv_pool_allocator.get_kvcache()
+            start = len(batch.reqs[0].origin_input_ids) + output_len_before - 1
+            prefix_locs = self.req_to_token_pool.req_to_token[
+                batch.req_pool_indices[0], :start
+            ].long().clone()
+            prefix_snapshot = [
+                (
+                    layer,
+                    pool.get_key_buffer(layer)[prefix_locs].clone(),
+                    pool.get_value_buffer(layer)[prefix_locs].clone(),
+                )
+                for layer in range(pool.start_layer, pool.start_layer + pool.layer_num)
+            ]
+        with annotation, get_spec().override(speculative_num_draft_tokens=width):
+            result = super().forward_batch_generation(
+                batch, on_publish, pp_proxy_tensors
+            )
+        if self.trace and decoding:
+            # Diagnostic synchronization only; disabled in timing runs. Row i
+            # predicts the token after input i, so a linear accepted prefix can
+            # be aligned directly with emitted output positions.
+            extra = {}
+            if self.trace_logits:
+                values, indices = result.logits_output.next_token_logits.topk(2, dim=-1)
+                # Check the actual GPU tree reconstruction and accepted chain,
+                # independently of the scheduler's final output processing.
+                start = len(batch.reqs[0].origin_input_ids) + output_len_before - 1
+                positions = self.positions_batch[1].cpu().tolist()
+                retrieve = self.retrieve_indexes_batch[1].cpu().tolist()[0]
+                links = self.retrieve_next_token_batch[1].cpu().tolist()[0]
+                siblings = self.retrieve_next_sibling_batch[1].cpu().tolist()[0]
+                accepted = int(result.accept_lens.cpu().tolist()[0])
+                predictions = result.logits_output.next_token_logits.argmax(-1).cpu().tolist()
+                emitted = result.next_token_ids.cpu().tolist()[:accepted]
+                import torch
+
+                for layer, keys_before, values_before in prefix_snapshot:
+                    assert torch.equal(keys_before, pool.get_key_buffer(layer)[prefix_locs]), (
+                        "Existing key prefix changed", layer
+                    )
+                    assert torch.equal(values_before, pool.get_value_buffer(layer)[prefix_locs]), (
+                        "Existing value prefix changed", layer
+                    )
+                settled = self.req_to_token_pool.req_to_token[
+                    batch.req_pool_indices[0], start:start + accepted
+                ].long()
+                assert torch.equal(settled, batch.out_cache_loc[:accepted].long()), (
+                    "Linear accepted KV slots differ from processed input slots"
+                )
+                assert positions == list(range(start, start + width)), positions
+                assert retrieve == list(range(width)), retrieve
+                assert links == list(range(1, width)) + [-1], links
+                assert siblings == [-1] * width, siblings
+                assert 1 <= accepted <= width, accepted
+                assert emitted == predictions[:accepted], (emitted, predictions)
+                assert tokens[1:accepted] == predictions[:accepted - 1]
+                assert accepted == width or tokens[accepted] != predictions[accepted - 1]
+                assert result.new_seq_lens.cpu().tolist() == [start + accepted]
+                extra = {
+                    "gpu_layout_and_acceptance_checked": True,
+                    "existing_kv_prefix_unchanged": True,
+                    "accepted_kv_slots_checked": True,
+                    "positions": positions,
